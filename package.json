{
  "name": "bifi-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "dev": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:base-app": "cd ./projects/base-app && ng build && cd ../../dist/base-app && npm pack",
    "build:asset-roaster": "cd ./projects/asset-roaster && ng build && cd ../../dist/asset-roaster && npm pack",
