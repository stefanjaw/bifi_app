{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "base-app": {
      "projectType": "library",
      "root": "projects/base-app",
      "sourceRoot": "projects/base-app/src",
      "prefix": "bifi-app",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/base-app/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/base-app/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/base-app/tsconfig.spec.json"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/base-app/**/*.ts", "projects/base-app/**/*.html"],
            "eslintConfig": "projects/base-app/eslint.config.js"
          }
        }
      }
    },
    "asset-roster": {
      "projectType": "library",
      "root": "projects/asset-roster",
      "sourceRoot": "projects/asset-roster/src",
      "prefix": "bifi-app",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/asset-roster/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/asset-roster/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/asset-roster/tsconfig.spec.json"
          }
        }
      }
    },
    "asset-roster-demo": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/asset-roster-demo",
      "sourceRoot": "projects/asset-roster-demo/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/asset-roster-demo/src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "projects/asset-roster-demo/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/asset-roster-demo/public"
              }
            ],
            "styles": ["projects/asset-roster-demo/src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "4MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "projects/asset-roster-demo/src/environments/environment.ts",
                  "with": "projects/asset-roster-demo/src/environments/environment.development.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "allowedHosts": ["61727dcc-e441-4690-bb21-4333a8c626e2-00-38jwgcs6m0b8o.picard.replit.dev", ".replit.dev"]
          },
          "configurations": {
            "production": {
              "buildTarget": "asset-roster-demo:build:production"
            },
            "development": {
              "buildTarget": "asset-roster-demo:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": ["zone.js", "zone.js/testing"],
            "tsConfig": "projects/asset-roster-demo/tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/asset-roster-demo/public"
              }
            ],
            "styles": ["projects/asset-roster-demo/src/styles.css"]
          }
        }
      }
    },
    "calendar": {
      "projectType": "library",
      "root": "projects/calendar",
      "sourceRoot": "projects/calendar/src",
      "prefix": "bifi-app",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/calendar/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/calendar/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/calendar/tsconfig.spec.json",
            "polyfills": ["zone.js", "zone.js/testing"]
          }
        }
      }
    },
    "crm": {
      "projectType": "library",
      "root": "projects/crm",
      "sourceRoot": "projects/crm/src",
      "prefix": "bifi-app",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/crm/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/crm/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/crm/tsconfig.spec.json",
            "polyfills": ["zone.js", "zone.js/testing"]
          }
        }
      }
    },
    "website": {
      "projectType": "library",
      "root": "projects/website",
      "sourceRoot": "projects/website/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/website/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/website/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/website/tsconfig.spec.json",
            "polyfills": ["zone.js", "zone.js/testing"]
          }
        }
      }
    },
    "tasks": {
      "projectType": "library",
      "root": "projects/tasks",
      "sourceRoot": "projects/tasks/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/tasks/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/tasks/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/tasks/tsconfig.spec.json",
            "polyfills": ["zone.js", "zone.js/testing"]
          }
        }
      }
    },
    "projects": {
      "projectType": "library",
      "root": "projects/projects",
      "sourceRoot": "projects/projects/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/projects/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/projects/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/projects/tsconfig.spec.json",
            "polyfills": ["zone.js", "zone.js/testing"]
          }
        }
      }
    },
    "aduanix": {
      "projectType": "library",
      "root": "projects/aduanix",
      "sourceRoot": "projects/aduanix/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/aduanix/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/aduanix/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/aduanix/tsconfig.spec.json",
            "polyfills": ["zone.js", "zone.js/testing"]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
