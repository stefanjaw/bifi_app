{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "base-app": {
      "projectType": "library",
      "root": "projects/base-app",
      "sourceRoot": "projects/base-app/src",
      "prefix": "bifi-app",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/base-app/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/base-app/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/base-app/tsconfig.spec.json"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/base-app/**/*.ts", "projects/base-app/**/*.html"],
            "eslintConfig": "projects/base-app/eslint.config.js"
          }
        }
      }
    },
    "asset-roaster": {
      "projectType": "library",
      "root": "projects/asset-roaster",
      "sourceRoot": "projects/asset-roaster/src",
      "prefix": "bifi-app",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/asset-roaster/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/asset-roaster/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/asset-roaster/tsconfig.spec.json"
          }
        }
      }
    },
    "asset-roaster-demo": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/asset-roaster-demo",
      "sourceRoot": "projects/asset-roaster-demo/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/asset-roaster-demo/src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "projects/asset-roaster-demo/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/asset-roaster-demo/public"
              }
            ],
            "styles": ["projects/asset-roaster-demo/src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "4MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "projects/asset-roaster-demo/src/environments/environment.ts",
                  "with": "projects/asset-roaster-demo/src/environments/environment.development.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "asset-roaster-demo:build:production"
            },
            "development": {
              "buildTarget": "asset-roaster-demo:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": ["zone.js", "zone.js/testing"],
            "tsConfig": "projects/asset-roaster-demo/tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/asset-roaster-demo/public"
              }
            ],
            "styles": ["projects/asset-roaster-demo/src/styles.css"]
          }
        }
      }
    },
    "calendar": {
      "projectType": "library",
      "root": "projects/calendar",
      "sourceRoot": "projects/calendar/src",
      "prefix": "bifi-app",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/calendar/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/calendar/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/calendar/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    },
    "crm": {
      "projectType": "library",
      "root": "projects/crm",
      "sourceRoot": "projects/crm/src",
      "prefix": "bifi-app",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/crm/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/crm/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/crm/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        }
      }
    }
  }
}
