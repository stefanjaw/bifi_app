          }
        }
      }
    },
    "asset-roster-demo": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/asset-roster-demo",
      "sourceRoot": "projects/asset-roster-demo/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/asset-roster-demo/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/asset-roster-demo/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/asset-roster-demo/public"
              }
            ],
            "styles": [
              "projects/asset-roster-demo/src/styles.css",
              "node_modules/grapesjs/dist/css/grapes.min.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2MB",
                  "maximumError": "3MB"
                },
                {
                  "type": "any",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "projects/asset-roster-demo/src/environments/environment.ts",
                  "with": "projects/asset-roster-demo/src/environments/environment.development.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "allowedHosts": [
              "61727dcc-e441-4690-bb21-4333a8c626e2-00-38jwgcs6m0b8o.picard.replit.dev",
              ".replit.dev"
            ],
            "headers": {
              "Cache-Control": "no-store, no-cache, must-revalidate, proxy-revalidate",
              "Pragma": "no-cache",
              "Expires": "0",
              "Access-Control-Allow-Origin": "*",
              "Access-Control-Allow-Methods": "GET, OPTIONS",
              "Access-Control-Allow-Headers": "*"
            }
          },
          "configurations": {
            "production": {
              "buildTarget": "asset-roster-demo:build:production"
            },
            "development": {
              "buildTarget": "asset-roster-demo:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/asset-roster-demo/tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/asset-roster-demo/public"
              }
            ],
            "styles": [
              "projects/asset-roster-demo/src/styles.css"
            ]
          }
        }
      }
    },
