/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      // "@avalantec/asset-roaster/*": [
      //   "projects/asset-roaster/*",
      //   "projects/asset-roaster"
      // ],
      // "@avalantec/base-app/*": ["projects/base-app/*", "projects/base-app"],
      // "@avalantec/asset-roaster": [
      //   "dist/asset-roaster/*",
      //   "dist/asset-roaster"
      // ],
      // "@avalantec/base-app": ["dist/base-app/*", "dist/base-app"]

      // "@avalantec/asset-roaster": [
      //   "dist/asset-roaster/*",
      //   "dist/asset-roaster"
      // ],
      // "@avalantec/base-app": ["dist/base-app/*", "dist/base-app"],

      // "@avalantec/asset-roaster/*": [
      //   "projects/asset-roaster/*",
      //   "projects/asset-roaster"
      // ],
      // "@avalantec/base-app/*": ["projects/base-app/*", "projects/base-app"]

      // Works on localhost
      "@avalantec/asset-roaster": ["projects/asset-roaster/src/lib"],
      "@avalantec/asset-roaster/*": ["projects/asset-roaster/src/lib/*"],

      // "@avalantec/base-app": ["projects/base-app/src/lib"],
      // "@avalantec/base-app/*": ["projects/base-app/src/lib/*"]

      "@avalantec/base-app": ["projects/base-app/src/lib"],
      "@avalantec/base-app/*": ["projects/base-app/src/lib/*"],
      "@avalantec/*": ["projects/base-app/*/src/index.ts"]
    },
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "typeCheckHostBindings": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./projects/base-app/tsconfig.lib.json"
    },
    {
      "path": "./projects/base-app/tsconfig.spec.json"
    },
    {
      "path": "./projects/asset-roaster/tsconfig.lib.json"
    },
    {
      "path": "./projects/asset-roaster/tsconfig.spec.json"
    },
    {
      "path": "./projects/asset-roaster-demo/tsconfig.app.json"
    },
    {
      "path": "./projects/asset-roaster-demo/tsconfig.spec.json"
    },
    {
      "path": "./projects/asset-roaster-demo/tsconfig.app.json"
    },
    {
      "path": "./projects/asset-roaster-demo/tsconfig.spec.json"
    }
  ]
}
