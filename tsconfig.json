/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      // Works on localhost
      "@avalantec/asset-roster": ["projects/asset-roster/src/lib"],
      "@avalantec/asset-roster/*": ["projects/asset-roster/src/lib/*"],

      "@avalantec/calendar": ["./projects/calendar/src/lib"],
      "@avalantec/calendar/*": ["./projects/calendar/src/lib/*"],

      "@avalantec/crm": ["./projects/crm/src/lib"],
      "@avalantec/crm/*": ["./projects/crm/src/lib/*"],

      "@avalantec/website": ["./projects/website/src/lib"],
      "@avalantec/website/*": ["./projects/website/src/lib/*"],

      "@avalantec/tasks": ["./projects/tasks/src/lib"],
      "@avalantec/tasks/*": ["./projects/tasks/src/lib/*"],

      "@avalantec/base-app": ["./projects/base-app"],
      "@avalantec/base-app/*": ["./projects/base-app/*"]
    },
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "typeCheckHostBindings": true,
    "strictTemplates": true
  },
  "include": [
    "**/src/**/*",
    "**/dist/**/*",
    "**/types/**/*",
    "projects/base-app/core/index.ts",
    "projects/base-app/form/index.ts",
    "projects/base-app/resource/index.ts",
    "projects/base-app/settings/src/services",
    "projects/base-app/settings/index.ts",
    "projects/base-app/settings/src/modules",
    "projects/base-app/settings/src/components",
    "projects/base-app/interfaces/user.ts"
  ],
  "exclude": ["**/node_modules", "**/**/*.spec.ts"]
}
