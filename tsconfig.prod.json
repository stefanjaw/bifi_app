/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declarationMap": false,
    "baseUrl": "./",
    "paths": {
      "@avalantec/base-app": ["dist/base-app/src", "./projects/base-app/src"],
      "@avalantec/base-app/*": ["dist/base-app/*", "./projects/base-app/*"],

      "@avalantec/asset-roster": ["dist/asset-roster/*", "dist/asset-roster"],
      "@avalantec/asset-roster/*": ["projects/asset-roster/*", "projects/asset-roster"],

      "@avalantec/calendar": ["dist/calendar/*", "dist/calendar"],
      "@avalantec/calendar/*": ["projects/calendar/*", "projects/calendar"],

      "@avalantec/crm": ["dist/crm/*", "dist/crm"],
      "@avalantec/crm/*": ["projects/crm/*", "projects/crm"],

      "@avalantec/website": ["dist/website/*", "dist/website"],
      "@avalantec/website/*": ["projects/website/*", "projects/website"],

      "@avalantec/tasks": ["dist/tasks/*", "dist/tasks"],
      "@avalantec/tasks/*": ["projects/tasks/*", "projects/tasks"],

      "@avalantec/projects": ["dist/projects/*", "dist/projects"],
      "@avalantec/projects/*": ["projects/projects/*", "projects/projects"],

      "@avalantec/aduanix": ["dist/aduanix/*", "dist/aduanix"],
      "@avalantec/aduanix/*": ["projects/aduanix/*", "projects/aduanix"]
    }
  },
  "angularCompilerOptions": {
    "compilationMode": "partial"
  }
}
