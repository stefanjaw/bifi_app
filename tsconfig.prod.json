/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declarationMap": false,
    "baseUrl": "./",
    "paths": {
      "@avalantec/base-app": ["dist/base-app/src", "./projects/base-app/src"],
      "@avalantec/base-app/*": ["dist/base-app/*", "./projects/base-app/*"],

      "@avalantec/asset-roster": ["dist/asset-roster/*", "dist/asset-roster"],
      "@avalantec/asset-roster/*": ["projects/asset-roster/*", "projects/asset-roster"],

      "@avalantec/calendar": ["dist/calendar/*", "dist/calendar"],
      "@avalantec/calendar/*": ["projects/calendar/*", "projects/calendar"],

      "@avalantec/website": ["dist/website/*", "dist/website"],
      "@avalantec/website/*": ["projects/website/*", "projects/website"],

      "@avalantec/tasks": ["dist/tasks/*", "dist/tasks"],
      "@avalantec/tasks/*": ["projects/tasks/*", "projects/tasks"],

      "@avalantec/projects": ["dist/projects/*", "dist/projects"],
      "@avalantec/projects/*": ["projects/projects/*", "projects/projects"],

      "@avalantec/aduanix": ["dist/aduanix/*", "dist/aduanix"],
      "@avalantec/aduanix/*": ["projects/aduanix/*", "projects/aduanix"],

      "@avalantec/sales": ["dist/sales/*", "dist/sales"],
      "@avalantec/sales/*": ["projects/sales/*", "projects/sales"],

      "@avalantec/purchases": ["dist/purchases/*", "dist/purchases"],
      "@avalantec/purchases/*": ["projects/purchases/*", "projects/purchases"],

      "@avalantec/inventory": ["dist/inventory/*", "dist/inventory"],
      "@avalantec/inventory/*": ["projects/inventory/*", "projects/inventory"],

      "@avalantec/helpdesk": ["dist/helpdesk/*", "dist/helpdesk"],
      "@avalantec/helpdesk/*": ["projects/helpdesk/*", "projects/helpdesk"],

      "@avalantec/accounting": ["dist/accounting/*", "dist/accounting"],
      "@avalantec/accounting/*": ["projects/accounting/*", "projects/accounting"]
    }
  },
  "angularCompilerOptions": {
    "compilationMode": "partial"
  }
}
