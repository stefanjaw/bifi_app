/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declarationMap": false,
    "baseUrl": "./",
    "paths": {
      "@avalantec/base-app": ["dist/base-app/src", "./projects/base-app/src"],
      "@avalantec/base-app/*": ["dist/base-app/*", "./projects/base-app/*"],

      "@avalantec/asset-roaster": ["dist/asset-roaster/*", "dist/asset-roaster"],
      "@avalantec/asset-roaster/*": ["projects/asset-roaster/*", "projects/asset-roaster"],

      "@avalantec/calendar": ["dist/calendar/*", "dist/calendar"],
      "@avalantec/calendar/*": ["projects/calendar/*", "projects/calendar"],

      "@avalantec/crm": ["dist/crm/*", "dist/crm"],
      "@avalantec/crm/*": ["projects/crm/*", "projects/crm"]
    }
  },
  "angularCompilerOptions": {
    "compilationMode": "partial"
  }
}
